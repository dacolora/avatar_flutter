<?xml version="1.0" encoding="utf-8"?>
<!--
  Metadatos del widget. `minWidth`/`minHeight` son el tamaño chico
  (equivalente a `.systemSmall` en iOS); como `resizeMode` permite
  horizontal|vertical, el usuario puede agrandarlo hasta `minResizeWidth`/
  `minResizeHeight`, momento en el que `AvatarWidgetProvider` muestra el
  texto (ver `CAPTION_MIN_WIDTH_DP`).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="80dp"
    android:minHeight="80dp"
    android:minResizeWidth="80dp"
    android:minResizeHeight="80dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:initialLayout="@layout/avatar_widget" />
