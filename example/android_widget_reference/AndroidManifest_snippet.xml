<!--
  No es un archivo que se use tal cual: es el <receiver> que hay que copiar
  dentro de la etiqueta <application> de
  example/android/app/src/main/AndroidManifest.xml (generado por
  `flutter create --platforms=android .`, ver README).

  `android:exported="true"` es necesario: el widget lo dispara el launcher
  del sistema (otro proceso), y desde Android 12 los receivers a los que
  apunta un proceso externo tienen que declarar `exported` explícitamente.
-->
<receiver
    android:name=".AvatarWidgetProvider"
    android:exported="true">
    <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
    </intent-filter>
    <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/avatar_widget_info" />
</receiver>
